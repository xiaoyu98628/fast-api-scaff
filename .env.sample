# 项目名称
APP_NAME=fast-api-scaff
# 项目环境
APP_ENV=local
# 是否开启调试
APP_DEBUG=true
# 项目端口
APP_PORT=8000
# 服务编码（三位数字，必须唯一）
SERVICE_CODE=001

# ---------- 数据库----------
DB_CONNECTION=mysql

DB_ECHO="${APP_DEBUG}"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# mysql
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=fast-api
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=root
DB_MYSQL_CHARSET=utf8mb4

# postgresql
DB_POSTGRESQL_HOST=127.0.0.1
DB_POSTGRESQL_PORT=5432
DB_POSTGRESQL_DATABASE=fast-api
DB_POSTGRESQL_USERNAME=postgres
DB_POSTGRESQL_PASSWORD=postgres

# sqlite
DB_SQLITE_FILE=database/database.sqlite