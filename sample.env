# 运行环境本地时区；必须在 Python 进程启动前设置
TZ=Asia/Shanghai

# 项目名称
APP_NAME=fast-api-scaff
# 项目版本
APP_VERSION=3.0.7
# 项目环境
APP_ENV=local
# 是否开启调试
APP_DEBUG=false
# Compose 宿主机发布端口
APP_PORT=8000
# 服务编码（三位数字，必须唯一）
APP_SERVICE_CODE=001

# ---------- 认证 ----------
# 数据库会话固定有效期，单位秒；范围 1–2592000，默认 3600
AUTH_SESSION_TTL_SECONDS=3600

# ---------- 日志 ----------
# 应用和 Uvicorn 日志级别：DEBUG、INFO、WARNING、ERROR、CRITICAL
LOG_LEVEL=INFO
# 日志输出格式：json、text
LOG_FORMAT=json
# 是否记录 HTTP 访问日志
LOG_ACCESS_ENABLED=true
# 不记录成功访问日志的完整请求路径；失败请求仍然记录
LOG_ACCESS_EXCLUDE_ROUTES=["/health"]
# 当前启用的日志 Handler；内置 stream 驱动支持 stdout 和 stderr
LOG_ACTIVE_HANDLERS=["stdout"]
LOG_HANDLERS__STDOUT__DRIVER=stream
LOG_HANDLERS__STDOUT__STREAM=stdout

# ---------- 跨域 ----------
# 列表可用 JSON，如 CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# X-Request-ID 始终对浏览器暴露，此处配置其他需要暴露的响应头
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=false
CORS_EXPOSE_HEADERS=["*"]
CORS_MAX_AGE=600

# ---------- HTTP 出站 ----------
# 普通请求和流式请求共享阶段超时，但使用独立连接池
HTTP_TIMEOUT__CONNECT=3.0
HTTP_TIMEOUT__READ=10.0
HTTP_TIMEOUT__WRITE=10.0
HTTP_POOL__TIMEOUT=5.0
HTTP_POOL__MAX_CONNECTIONS=100
HTTP_POOL__MAX_KEEPALIVE_CONNECTIONS=20
HTTP_POOL__KEEPALIVE_EXPIRY=30.0
HTTP_STREAM_POOL__TIMEOUT=10.0
HTTP_STREAM_POOL__MAX_CONNECTIONS=100
HTTP_STREAM_POOL__MAX_KEEPALIVE_CONNECTIONS=10
HTTP_STREAM_POOL__KEEPALIVE_EXPIRY=30.0
# 单个池的进行中请求达到容量比例时记录一次压力告警，降到阈值以下后可再次触发
HTTP_POOL_WARNING_RATIO=0.8
# 普通响应解压后的最大缓冲字节数；流式响应由调用方按协议控制
HTTP_MAX_RESPONSE_BYTES=10485760
HTTP_VERIFY=true
HTTP_FOLLOW_REDIRECTS=false
# 是否读取 HTTP_PROXY、HTTPS_PROXY、NO_PROXY 等进程环境变量
HTTP_TRUST_ENV=false

# ---------- 数据库 ----------
# 默认连接名；未使用数据库时不会校验具体连接配置
DB_DEFAULT=main

# MySQL 默认连接
DB_CONNECTIONS__MAIN__DRIVER=mysql
DB_CONNECTIONS__MAIN__HOST=127.0.0.1
DB_CONNECTIONS__MAIN__PORT=3306
DB_CONNECTIONS__MAIN__DATABASE=fast-api-scaff
DB_CONNECTIONS__MAIN__USERNAME=root
DB_CONNECTIONS__MAIN__PASSWORD=root
# 使用统一结构化日志记录 SQL，不启用 SQLAlchemy 原生 echo
DB_CONNECTIONS__MAIN__ECHO="${APP_DEBUG}"
# 慢查询阈值（毫秒），0 表示禁用慢查询日志
DB_CONNECTIONS__MAIN__SLOW_QUERY_MS=500
DB_CONNECTIONS__MAIN__POOL_SIZE=10
DB_CONNECTIONS__MAIN__MAX_OVERFLOW=20
DB_CONNECTIONS__MAIN__POOL_PRE_PING=true
DB_CONNECTIONS__MAIN__POOL_RECYCLE=3600

# PostgreSQL 命名连接
DB_CONNECTIONS__LEGACY__DRIVER=postgresql
DB_CONNECTIONS__LEGACY__HOST=127.0.0.1
DB_CONNECTIONS__LEGACY__PORT=5432
DB_CONNECTIONS__LEGACY__DATABASE=legacy
DB_CONNECTIONS__LEGACY__USERNAME=root
DB_CONNECTIONS__LEGACY__PASSWORD=root

# SQLite 命名连接
DB_CONNECTIONS__LOCAL__DRIVER=sqlite
DB_CONNECTIONS__LOCAL__DATABASE=data/database.sqlite

# ---------- 缓存 ----------
# 默认连接名；配置错误会在应用启动时报告，远程服务连接仍延迟到首次操作
CACHE_DEFAULT=session
# 应用级 key 命名空间；配置任意缓存连接时不能为空，不能以冒号开头或结尾
CACHE_NAMESPACE=fast-api-scaff
# 未显式传入 ttl 时使用的秒数，未配置时默认为 300
CACHE_DEFAULT_TTL=300

# Redis 默认连接
CACHE_CONNECTIONS__SESSION__DRIVER=redis
CACHE_CONNECTIONS__SESSION__HOST=127.0.0.1
CACHE_CONNECTIONS__SESSION__PORT=6379
CACHE_CONNECTIONS__SESSION__DATABASE=0
# 连接用途前缀，最终 key 为 fast-api-scaff:session:业务key
CACHE_CONNECTIONS__SESSION__KEY_PREFIX=session
CACHE_CONNECTIONS__SESSION__MAX_CONNECTIONS=10
CACHE_CONNECTIONS__SESSION__CONNECT_TIMEOUT=5.0
CACHE_CONNECTIONS__SESSION__READ_TIMEOUT=5.0
CACHE_CONNECTIONS__SESSION__SSL=false
# Redis 认证可按需启用
# CACHE_CONNECTIONS__SESSION__USERNAME=redis
# CACHE_CONNECTIONS__SESSION__PASSWORD=redis

# Memcached 命名连接；USERNAME 和 PASSWORD 必须同时配置或同时省略
CACHE_CONNECTIONS__PAGE__DRIVER=memcached
CACHE_CONNECTIONS__PAGE__HOST=127.0.0.1
CACHE_CONNECTIONS__PAGE__PORT=11211
CACHE_CONNECTIONS__PAGE__KEY_PREFIX=page
# CACHE_CONNECTIONS__PAGE__USERNAME=memcached
# CACHE_CONNECTIONS__PAGE__PASSWORD=memcached
CACHE_CONNECTIONS__PAGE__MIN_CONNECTIONS=1
CACHE_CONNECTIONS__PAGE__MAX_CONNECTIONS=10
CACHE_CONNECTIONS__PAGE__CONNECT_TIMEOUT=5.0
CACHE_CONNECTIONS__PAGE__READ_TIMEOUT=5.0
CACHE_CONNECTIONS__PAGE__BLOCKING_TIMEOUT=5.0
CACHE_CONNECTIONS__PAGE__SSL=false

# Memory 仅用于测试和单进程本地开发，不用于生产降级
CACHE_CONNECTIONS__LOCAL__DRIVER=memory
CACHE_CONNECTIONS__LOCAL__KEY_PREFIX=local

# ---------- 队列 ----------
# 默认连接名；HTTP 启动时不会连接队列或启动消费者，首次队列操作才建立连接
QUEUE_DEFAULT=redis
QUEUE_MAX_MESSAGE_BYTES=1048576
QUEUE_FAILED__DATABASE=main
QUEUE_WORKER__CONCURRENCY=4
QUEUE_WORKER__SHUTDOWN_TIMEOUT_SECONDS=30

# Redis 默认连接（独立客户端与连接池，可使用与缓存相同的 Redis 服务）
QUEUE_CONNECTIONS__REDIS__DRIVER=redis
QUEUE_CONNECTIONS__REDIS__DEFAULT_QUEUE=default
QUEUE_CONNECTIONS__REDIS__PUBLISH_TIMEOUT=10
QUEUE_CONNECTIONS__REDIS__HOST=127.0.0.1
QUEUE_CONNECTIONS__REDIS__PORT=6379
QUEUE_CONNECTIONS__REDIS__DATABASE=0
# QUEUE_CONNECTIONS__REDIS__USERNAME=redis
# QUEUE_CONNECTIONS__REDIS__PASSWORD=redis
QUEUE_CONNECTIONS__REDIS__SSL=false
QUEUE_CONNECTIONS__REDIS__MAX_CONNECTIONS=10
QUEUE_CONNECTIONS__REDIS__CONNECT_TIMEOUT=5
QUEUE_CONNECTIONS__REDIS__GROUP=workers
QUEUE_CONNECTIONS__REDIS__PREFIX=queue:
QUEUE_CONNECTIONS__REDIS__LEASE_SECONDS=120
QUEUE_CONNECTIONS__REDIS__COMMAND_TIMEOUT=10

# Kafka 命名连接；Topic 必须可用
QUEUE_CONNECTIONS__KAFKA__DRIVER=kafka
QUEUE_CONNECTIONS__KAFKA__DEFAULT_QUEUE=events
QUEUE_CONNECTIONS__KAFKA__PUBLISH_TIMEOUT=10
QUEUE_CONNECTIONS__KAFKA__BOOTSTRAP_SERVERS=["127.0.0.1:9092"]
QUEUE_CONNECTIONS__KAFKA__GROUP=workers
QUEUE_CONNECTIONS__KAFKA__SECURITY_PROTOCOL=PLAINTEXT
QUEUE_CONNECTIONS__KAFKA__SASL_MECHANISM=PLAIN
# QUEUE_CONNECTIONS__KAFKA__USERNAME=kafka
# QUEUE_CONNECTIONS__KAFKA__PASSWORD=kafka
QUEUE_CONNECTIONS__KAFKA__MAX_POLL_INTERVAL_MS=300000

# RabbitMQ 命名连接；同名持久队列 + 默认 exchange
QUEUE_CONNECTIONS__RABBITMQ__DRIVER=rabbitmq
QUEUE_CONNECTIONS__RABBITMQ__DEFAULT_QUEUE=commands
QUEUE_CONNECTIONS__RABBITMQ__PUBLISH_TIMEOUT=10
QUEUE_CONNECTIONS__RABBITMQ__HOST=127.0.0.1
QUEUE_CONNECTIONS__RABBITMQ__PORT=5672
QUEUE_CONNECTIONS__RABBITMQ__VIRTUAL_HOST=/
QUEUE_CONNECTIONS__RABBITMQ__USERNAME=guest
QUEUE_CONNECTIONS__RABBITMQ__PASSWORD=guest
QUEUE_CONNECTIONS__RABBITMQ__SSL=false
QUEUE_CONNECTIONS__RABBITMQ__CONNECT_TIMEOUT=5
